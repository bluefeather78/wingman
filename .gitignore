# Secrets — never commit
.env
.env.*
!.env.example

# Local Claude Code settings (can accumulate secrets typed into commands)
.claude/settings.local.json

# Local user account database
users_db.json

# Python
__pycache__/
*.pyc

# Local virtualenv for the test suite:
#   python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt
#   .venv/bin/pytest
# `python -m venv` writes a self-ignoring .gitignore inside the directory, so this
# rule is belt-and-braces -- an env built by an older tool would not carry one, and
# a `git add -A` would then commit several thousand files.
.venv/
venv/

# Logs
server.log
server_err.log
refresh_run.log
refresh_final.log

# Captured stdout of admin-console agent runs (one file per run)
agent_logs/

# Local dev-server PID, written by restart_server.ps1
.server.pid
server_restart.log

# Lockfile preventing two web-search agents from sharing the Google Search quota
.gemini_web_search.lock

# Per-machine agent timing overrides, edited from the admin console's timing table
agent_settings.json

# Dry-run snapshots written by the agent scripts
*_dry_run_*.json
scrape_review_*.json
hub_review_*.json
names_review_*.json
# Phase 4F's lead work-list: local run state (which leads exist, which are processed),
# regenerated free from any run's grounding. Same reasoning as the review snapshots above.
discovered_leads.jsonl
# The catalog embedding index (dedupe): local run state, regenerated by
# build_catalog_embeddings.py. Multi-MB and churns with the catalog — same reasoning as above.
catalog_embeddings.jsonl

#gitignore
.gitignore

# pytest / coverage artifacts
.coverage
.pytest_cache/
htmlcov/

# Dev-only test account credentials (dev_test_account.py)
.test-account.json

# Expo web build output and cache. `expo export -p web` writes frontend/dist (a ~1.9MB
# bundle) and frontend/.expo; Render regenerates both on every deploy from its own build
# command, so a committed copy is dead weight that also churns on every build, and a local
# `expo export` run leaves them staged-able.
frontend/dist/
frontend/.expo/

# The dependency tree, restored by `npm ci` from package-lock.json. NOT optional and NOT
# "already covered" — the comment above used to say node_modules was, and it never had a
# rule in any version of this file. It had simply never existed here, because the frontend
# was built on another machine. The first `npm ci` run on this one (needed to get
# `npx tsc --noEmit` working) put 439MB / 35,087 files in the tree, and a blanket `git add`
# swept every one of them into what was meant to be a 1-file doc commit. They were scrubbed
# back out of the branch history; this line is what stops it happening again.
frontend/node_modules/

# Secrets — never commit
.env
.env.*
!.env.example

# Local Claude Code settings (can accumulate secrets typed into commands)
.claude/settings.local.json

# Local user account database
users_db.json

# Python
__pycache__/
*.pyc

# Logs
server.log
server_err.log
refresh_run.log
refresh_final.log

# Captured stdout of admin-console agent runs (one file per run)
agent_logs/

# Local dev-server PID, written by restart_server.ps1
.server.pid
server_restart.log

# Lockfile preventing two web-search agents from sharing the Google Search quota
.gemini_web_search.lock

# Per-machine agent timing overrides, edited from the admin console's timing table
agent_settings.json

# Dry-run snapshots written by the agent scripts
*_dry_run_*.json
scrape_review_*.json
hub_review_*.json
names_review_*.json
# Phase 4F's lead work-list: local run state (which leads exist, which are processed),
# regenerated free from any run's grounding. Same reasoning as the review snapshots above.
discovered_leads.jsonl
# The catalog embedding index (dedupe): local run state, regenerated by
# build_catalog_embeddings.py. Multi-MB and churns with the catalog — same reasoning as above.
catalog_embeddings.jsonl

#gitignore
.gitignore

# pytest / coverage artifacts
.coverage
.pytest_cache/
htmlcov/

# Dev-only test account credentials (dev_test_account.py)
.test-account.json
